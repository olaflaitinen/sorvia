# Copy to .env and replace every value. Never commit .env.

POSTGRES_PASSWORD=change-me-postgres
SORVIA_API_DB_PASSWORD=change-me-api
SORVIA_NL_DB_PASSWORD=change-me-reader

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SORVIA_JWT_SECRET=change-me-in-production-please-32-bytes-minimum
SORVIA_FIN_KEY=change-me-fin-key
SORVIA_ENVIRONMENT=development

# Demo users (admin, menecer, aysel.bak01, tural.gnc01) are created when this is set.
SORVIA_DEMO_PASSWORD=Demo-Pass-2026
SORVIA_SEED_SCALE=1

# Language model.
#   static: offline oracle that answers the benchmark questions (default, no key needed)
#   openai: any OpenAI-compatible /chat/completions endpoint (hosted API, vLLM, Ollama, LM Studio)
SORVIA_LLM_PROVIDER=static
SORVIA_STATIC_SQL_PATH=/app/benchmark/data/az_text2sql_v1.jsonl
# SORVIA_LLM_PROVIDER=openai
# SORVIA_LLM_BASE_URL=http://host.docker.internal:11434/v1
# SORVIA_LLM_MODEL=<model name>
# SORVIA_LLM_API_KEY=

SORVIA_STRATEGY=retrieval_fewshot
SORVIA_MAX_ROWS=500
SORVIA_STATEMENT_TIMEOUT_MS=5000
SORVIA_MAX_PLAN_COST=5000000
SORVIA_RATE_LIMIT_PER_MINUTE=30
# JSON list, for the web client later: ["http://localhost:5173"]
SORVIA_CORS_ORIGINS=[]
